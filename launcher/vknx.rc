// Win32 resources of vKNX.exe, compiled by make-res.ps1 (rc.exe) and linked with <Win32Resource>.
// Icon group 1 is the default icon of the program and its shortcuts (the penguin). Icon group 2 is the original
// "V" icon: Windows lists every icon group of the exe in Properties > Shortcut > Change Icon...
#include "version.h" // generated by make-res.ps1: VER_MAJOR, VER_MINOR, VER_PATCH, VER_STRING

1 ICON "penguin.ico"
2 ICON "vknx-v.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Marc Sonne Dahl"
      VALUE "FileDescription", "vKNX - virtual KNX installation for teaching"
      VALUE "FileVersion", VER_STRING
      VALUE "InternalName", "vKNX"
      VALUE "OriginalFilename", "vKNX.exe"
      VALUE "ProductName", "vKNX"
      VALUE "ProductVersion", VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
