<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>vKNX</AssemblyName>
    <RootNamespace>VKnx.Launcher</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <!-- icons (penguin default + original V), manifest and version info are compiled into vknx.res by make-res.ps1 -->
    <Win32Resource>vknx.res</Win32Resource>
    <NoWin32Manifest>true</NoWin32Manifest>
    <Version>0.0.0</Version>
    <Product>vKNX</Product>
    <Company>Marc Sonne Dahl</Company>
    <Description>vKNX - virtual KNX installation for teaching</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>
</Project>
