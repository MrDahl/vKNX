<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>vKNX</AssemblyName>
    <RootNamespace>VKnx.Launcher</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon>vknx.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <Product>vKNX</Product>
    <Company>Marc Sonne Dahl</Company>
    <Description>vKNX - virtuel KNX-installation til undervisning</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>
</Project>
