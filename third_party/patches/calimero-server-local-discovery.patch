+	private static boolean fromThisComputer(final EndpointAddress src) {
+		if (!(src instanceof UdpEndpointAddress udp) || udp.address().getAddress() == null)
+			return false;
+		final InetAddress a = udp.address().getAddress();
+		try {
+			return a.isLoopbackAddress() || a.isAnyLocalAddress() || NetworkInterface.getByInetAddress(a) != null;
+		}
+		catch (final java.net.SocketException e) {
+			return false;
+		}
+	}
