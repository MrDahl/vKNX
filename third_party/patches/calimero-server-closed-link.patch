@@ -111,6 +111,10 @@ public class VirtualLink extends AbstractLink<AutoCloseable>
 
 	@Override
 	protected void onClose() {
+		// vKNX patch: a closed device link leaves its uplink's list; before, a removed device stayed on the line and
+		// went on receiving group telegrams
+		if (isDeviceLink)
+			deviceLinks.forEach(uplink -> uplink.deviceLinks.remove(this));
